{
  "name": "credit-card-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-verified-cards.ts",
    "setup:db": "npm run migrate && npm run seed && npm run seed -- --approve && npm run seed:invites",
    "verify:seed": "tsx scripts/verify-seed.ts",
    "seed:strategies": "tsx scripts/seed-strategies.ts",
    "verify:strategies": "tsx scripts/verify-strategies.ts",
    "seed:invites": "tsx scripts/seed-invites.ts",
    "up": "docker compose up --build -d",
    "down": "docker compose down",
    "dev:setup": "docker compose up -d postgres && sleep 2 && npm run migrate",
    "lint": "eslint",
    "stop-request": "tsx scripts/stop-request.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "next": "^15.3.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.23",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0"
  }
}
